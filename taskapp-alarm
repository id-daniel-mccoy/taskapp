#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PATH="/usr/bin:/usr/local/bin:${PATH:-}"
CONFIG="${XDG_CONFIG_HOME:-$HOME/.config}/Taskapp"
STORE="$CONFIG/alarms.json"
ICON="$ROOT/resources/icon.png"

if [[ -n "${XDG_RUNTIME_DIR:-}" ]]; then
  RUNTIME="$XDG_RUNTIME_DIR/taskapp"
elif [[ -d "/run/user/${UID:-}" ]]; then
  RUNTIME="/run/user/${UID}/taskapp"
else
  RUNTIME="/tmp/taskapp-${UID:-user}"
fi
mkdir -p "$RUNTIME"

RING_ID_FILE="$RUNTIME/ring.id"
RING_PID_FILE="$RUNTIME/ring.pid"
PLAYER_PID_FILE="$RUNTIME/player.pid"

usage() {
  echo "Usage: taskapp-alarm ring <id> | snooze <id> | stop" >&2
  exit 2
}

play_once() {
  local file="$1"
  if command -v paplay >/dev/null 2>&1; then
    paplay "$file"
  elif command -v pw-play >/dev/null 2>&1; then
    pw-play "$file"
  elif command -v canberra-gtk-play >/dev/null 2>&1; then
    canberra-gtk-play -f "$file"
  elif command -v ffplay >/dev/null 2>&1; then
    ffplay -nodisp -autoexit -loglevel quiet "$file"
  else
    sleep 2
    return 1
  fi
}

kill_pidfile() {
  local file="$1"
  local pid
  [[ -r "$file" ]] || return 0
  pid="$(tr -d '[:space:]' < "$file")"
  if [[ "$pid" =~ ^[0-9]+$ ]]; then
    kill "$pid" >/dev/null 2>&1 || true
    sleep 0.05
    kill -9 "$pid" >/dev/null 2>&1 || true
  fi
  rm -f "$file"
}

stop_ring() {
  rm -f "$RING_ID_FILE"
  kill_pidfile "$PLAYER_PID_FILE"
  if [[ -r "$RING_PID_FILE" ]]; then
    pid="$(tr -d '[:space:]' < "$RING_PID_FILE")"
    if [[ "$pid" =~ ^[0-9]+$ && "$pid" != "$$" ]]; then
      kill "$pid" >/dev/null 2>&1 || true
    fi
  fi
  rm -f "$RING_PID_FILE"
}

read_alarm() {
  local id="$1"
  if [[ ! -f "$STORE" ]] || ! command -v python3 >/dev/null 2>&1; then
    SOUND=""
    LABEL="Alarm"
    ONCE="0"
    SNOOZE="10"
    return 0
  fi
  local data
  data="$(python3 - "$STORE" "$id" <<'PY'
import json, sys
path, alarm_id = sys.argv[1], sys.argv[2]
try:
    payload = json.loads(open(path, encoding="utf-8").read())
except Exception:
    sys.exit(0)
for alarm in payload.get("alarms", []):
    if alarm.get("id") == alarm_id:
        print(alarm.get("soundPath") or "")
        print(alarm.get("label") or "Alarm")
        print("1" if not alarm.get("days") else "0")
        print(int(alarm.get("snoozeMinutes") or 10))
        break
PY
)" || true
  SOUND="$(printf '%s\n' "$data" | sed -n '1p')"
  LABEL="$(printf '%s\n' "$data" | sed -n '2p')"
  ONCE="$(printf '%s\n' "$data" | sed -n '3p')"
  SNOOZE="$(printf '%s\n' "$data" | sed -n '4p')"
  LABEL="${LABEL:-Alarm}"
  ONCE="${ONCE:-0}"
  SNOOZE="${SNOOZE:-10}"
}

disable_one_shot() {
  local id="$1"
  command -v python3 >/dev/null 2>&1 || return 0
  python3 - "$STORE" "$id" <<'PY' >/dev/null 2>&1 || true
import json, sys
from pathlib import Path
path = Path(sys.argv[1])
alarm_id = sys.argv[2]
if not path.is_file():
    raise SystemExit(0)
payload = json.loads(path.read_text(encoding="utf-8"))
changed = False
for alarm in payload.get("alarms", []):
    if alarm.get("id") == alarm_id and not alarm.get("days"):
        alarm["enabled"] = False
        changed = True
if changed:
    path.write_text(json.dumps(payload, indent=2) + "\n", encoding="utf-8")
PY
  if command -v systemctl >/dev/null 2>&1; then
    systemctl --user disable --now "taskapp-alarm-${id}.timer" >/dev/null 2>&1 || true
  fi
}

notify_actions() {
  local id="$1"
  local label="$2"
  local snooze="$3"
  command -v notify-send >/dev/null 2>&1 || return 0
  (
    action="$(notify-send \
      --app-name=Taskapp \
      --icon="$ICON" \
      --urgency=critical \
      --expire-time=0 \
      --wait \
      --action=stop=Stop \
      --action=snooze="Snooze ${snooze} min" \
      "Alarm" \
      "$label" 2>/dev/null || true)"
    case "$action" in
      stop) "$ROOT/taskapp-alarm" stop ;;
      snooze) "$ROOT/taskapp-alarm" snooze "$id" ;;
    esac
  ) &
}

wake_app() {
  local id="$1"
  if [[ -x "$ROOT/taskapp" ]]; then
    "$ROOT/taskapp" --alarm-ring="$id" >/dev/null 2>&1 &
  fi
}

snooze_ring() {
  local id="$1"
  read_alarm "$id"
  stop_ring
  if command -v systemd-run >/dev/null 2>&1; then
    systemctl --user stop "taskapp-alarm-snooze-${id}.timer" >/dev/null 2>&1 || true
    systemctl --user stop "taskapp-alarm-snooze-${id}.service" >/dev/null 2>&1 || true
    systemd-run --user \
      --on-active="${SNOOZE}min" \
      --unit="taskapp-alarm-snooze-${id}" \
      --timer-property=AccuracySec=1s \
      --collect \
      "$ROOT/taskapp-alarm" ring "$id" >/dev/null 2>&1 || true
  fi
}

ring_alarm() {
  local id="$1"
  if [[ ! "$id" =~ ^[0-9a-fA-F-]{36}$ ]]; then
    echo "Invalid alarm id." >&2
    exit 1
  fi
  stop_ring
  read_alarm "$id"
  if [[ -z "$SOUND" || ! -f "$SOUND" ]]; then
    SOUND="/usr/share/sounds/gnome/default/alarms/bird.oga"
    if [[ ! -f "$SOUND" ]]; then
      SOUND="/usr/share/sounds/freedesktop/stereo/alarm-clock-elapsed.oga"
    fi
    if [[ ! -f "$SOUND" ]]; then
      SOUND="/usr/share/sounds/freedesktop/stereo/complete.oga"
    fi
  fi
  printf '%s\n' "$id" > "$RING_ID_FILE"
  printf '%s\n' "$$" > "$RING_PID_FILE"
  if [[ "$ONCE" == "1" ]]; then
    disable_one_shot "$id"
  fi
  notify_actions "$id" "$LABEL" "$SNOOZE"
  wake_app "$id"
  (
    while [[ -f "$RING_ID_FILE" ]]; do
      play_once "$SOUND" || sleep 1
    done
  ) &
  echo $! > "$PLAYER_PID_FILE"
  wait "$(cat "$PLAYER_PID_FILE")" 2>/dev/null || true
  rm -f "$RING_PID_FILE" "$PLAYER_PID_FILE" "$RING_ID_FILE"
}

cmd="${1:-}"
id="${2:-}"
case "$cmd" in
  ring)
    [[ -n "$id" ]] || usage
    ring_alarm "$id"
    ;;
  snooze)
    [[ -n "$id" ]] || usage
    snooze_ring "$id"
    ;;
  stop)
    stop_ring
    ;;
  *)
    usage
    ;;
esac
